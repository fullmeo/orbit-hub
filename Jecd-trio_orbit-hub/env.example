# ============================================================
# ORBIT Trio Hub — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# NE JAMAIS committer .env dans Git
# ============================================================

# --- STRIPE ---
# Récupérer sur https://dashboard.stripe.com/apikeys
STRIPE_PUBLISHABLE_KEY=pk_live_XXXXXXXXXXXXXXXXXXXX
STRIPE_SECRET_KEY=sk_live_XXXXXXXXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXX

# --- KO-FI ---
# Votre page Ko-fi : https://ko-fi.com/VOTRE_NOM
KOFI_URL=https://ko-fi.com/trioscd

# --- BACKEND URL ---
# Railway : https://VOTRE_APP.railway.app
BACKEND_URL=https://orbit-trio-api.railway.app

# --- EMAIL (Gmail SMTP) ---
# Créer un App Password sur https://myaccount.google.com/apppasswords
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=serignetrumpet@gmail.com
SMTP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# --- ADMIN ---
ADMIN_EMAIL=serignetrumpet@gmail.com

# --- GOOGLE ANALYTICS ---
GA_TRACKING_ID=G-XXXXXXXXXX

# --- NETLIFY ---
# Site URL (sans slash final)
SITE_URL=https://orbit-trio.netlify.app

# --- DEBUG ---
DEBUG=False
PORT=8000
HOST=0.0.0.0
