# ORBIT Trio Hub — Environment Variables (development)
# Copier ce fichier en .env et adapter les valeurs sensibles

# ── SMTP (emails) ───────────────────────────────────────────────────
# Pour Gmail : créer un "App Password" dans Compte → Sécurité
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# ── Stripe (paiements) ───────────────────────────────────────────────
# Clé publique (publishable) : utilisée par le frontend
STRIPE_PUBLISHABLE_KEY=pk_test_VOTRE_CLE_PUBLIQUE
# Clé secrète (secret key) : utilisée par le backend
STRIPE_API_KEY=sk_test_VOTRE_CLE_SECRETE
# Webhook secret (à générer dans dashboard Stripe → Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_VOTRE_SECRET_WEBHOOK
# Active/désactive les paiements (si vide = désactivé)
ENABLE_PAYMENTS=true

# ── JWT Auth (admin) ─────────────────────────────────────────────────
# Générer une clé secrète forte : `openssl rand -hex 32` ou Python secrets.token_hex(32)
JWT_SECRET_KEY=votre_secret_jwt_super_securise_remplacez_moi
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 heures

# ── Admin ────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@orbit-hub.netlify.app

# ── Backend ──────────────────────────────────────────────────────────
DEBUG=true
HOST=0.0.0.0
PORT=8000
# URL complète de l'API (pour logs et génération de liens)
BACKEND_URL=http://localhost:8000

# ── Site / PWA ───────────────────────────────────────────────────────
SITE_URL=http://localhost:8001
SITE_NAME="Trio Santos, Cirillo & Diagne"
