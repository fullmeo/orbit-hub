{
  "name": "orbit-hub",
  "version": "1.0.0",
  "description": "ORBIT Phase 0 - Artist Visibility Infrastructure with AI Fan Chat",
  "main": "index.html",
  "scripts": {
    "build": "echo 'Static site - no build required'",
    "start": "netlify dev",
    "dev": "netlify dev",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "coverage": "jest --coverage",
    "metrics": "jest --coverage && echo '✅ All metrics calculated'",
    "deploy:list": "node deploy-multi-site.js list",
    "deploy:all": "node deploy-multi-site.js deploy all",
    "deploy:allyson": "node deploy-multi-site.js deploy allyson-glado",
    "deploy:ouidah": "node deploy-multi-site.js deploy ouidah-jazz",
    "deploy:jecd": "node deploy-multi-site.js deploy jecd-trio",
    "init:site": "node -e \"require('child_process').execSync('powershell -NoProfile -ExecutionPolicy Bypass .\\\\init-new-artist-site.ps1', {stdio: 'inherit'})\" || bash init-new-artist-site.sh"
  },
  "keywords": [
    "artist",
    "visibility",
    "streaming",
    "music",
    "fan-chat",
    "claude-ai"
  ],
  "author": "Serigne DIAGNE",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.28.0"
  },
  "devDependencies": {
    "@netlify/functions": "^2.0.0",
    "@types/jest": "^30.0.0",
    "@types/supertest": "^7.2.0",
    "esbuild": "^0.19.0",
    "jest": "^30.3.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "18.0.0"
  }
}
