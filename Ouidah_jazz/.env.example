# ORBIT Hub Environment Variables

# ============================================================================
# ANTHROPIC API (Claude AI for Fan Chat & Thank You Messages)
# ============================================================================
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ============================================================================
# BREVO EMAIL (Newsletter + Escalation Contact)
# ============================================================================
BREVO_API_KEY=your_brevo_api_key_here

# ============================================================================
# CIRCLE API (USDC Tipping via Circle)
# ============================================================================
# Circle API Key (get from https://app.circle.com/settings/developer)
CIRCLE_API_KEY=your_circle_api_key_here

# Circle API URL - Use sandbox for testing
CIRCLE_API_URL=https://api.sandbox.circle.com

# Your Circle Wallet ID (for receiving tips)
CIRCLE_WALLET_ID=your_circle_wallet_id_here

# Circle Webhook Secret (for verifying webhook signatures)
CIRCLE_WEBHOOK_SECRET=your_circle_webhook_secret_here

# ============================================================================
# NETLIFY & CORS
# ============================================================================
# Allowed origin for CORS requests (update with your Netlify domain after deployment)
ALLOWED_ORIGIN=https://ouidah-jazz.netlify.app

# ============================================================================
# ARTIST CONFIGURATION (Fan Chat)
# ============================================================================
ARTIST_NAME=Togbé Adjos
ARTIST_BIO=Fondateur et artiste principal du Ouidah Blues, Jazz & Gospel Festival
ARTIST_TONE=authentique, mystique, soulful, contemplatif
